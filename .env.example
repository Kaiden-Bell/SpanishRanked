# Copy to `.env` (which is gitignored) and edit. Every value here is optional;
# the defaults shown are what docker-compose.yml uses when a variable is unset.

# Address the web UI is published on. Keep 127.0.0.1 unless you mean to share it.
# Use a private/VPN address (for example a Tailscale IP) for phone access; never a public one.
LANGUAGEAI_BIND_ADDR=127.0.0.1

# Where a "day" ends, for streaks and daily XP caps. IANA name, e.g. America/Chicago.
# Set it once at setup. Changing it later does not rewrite past XP.
LANGUAGEAI_TIMEZONE=UTC

# Sidecar services. The defaults point at the compose services; override to use an
# Ollama already running on the host (http://host.docker.internal:11434).
# LANGUAGEAI_LANGUAGETOOL_URL=http://languagetool:8010
# LANGUAGEAI_OLLAMA_URL=http://ollama:11434

# Model served by Ollama. qwen2.5:7b is the model the grading was evaluated with.
# LANGUAGEAI_MODEL=qwen2.5:7b
